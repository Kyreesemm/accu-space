import { Button, LineEdit, ScrollView, Slider } from "std-widgets.slint";

export struct CategoryRow { name: string, size: string, files: string, percent: string, ratio: float, color: color }
export struct Tile { x: float, y: float, width: float, height: float, label: string, size: string, color: color }
export struct DiskRow { name: string, path: string, total: string, used: string, free: string, used-ratio: float, kind: string }
export struct TreeRow { name: string, kind: string, size: string, files: string, indent: length, color: color, is-file: bool, expandable: bool, expanded: bool, key: string }
export struct TrashRow { key: string, name: string, path: string, size: string, count: string, category: string, description: string, selected: bool, ratio: float }

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 40px;
    min-width: 112px;
    background: primary ? #526579 : #30343a;
    border-radius: 8px;
    Text {
        text: label;
        color: #e7e9ec;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    width: 112px;
    background: #39434d;
    border-radius: 7px;
    Text { text: label; color: #e7e9ec; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback activate();
    height: 38px;
    background: selected ? #34383e : #1b1d20;
    border-radius: 8px;
    Image { source: root.icon; x: 11px; y: 10px; width: 18px; height: 18px; image-fit: contain; }
    Text { text: label; color: selected ? #f1f2f3 : #aeb2b8; font-size: 13px; vertical-alignment: center; x: 38px; }
    TouchArea { clicked => { root.activate(); } }
}

export component MainWindow inherits Window {
    title: "Accu Space";
    min-width: 900px;
    min-height: 620px;
    preferred-width: 1180px;
    preferred-height: 800px;
    background: #17181a;
    in-out property <string> root-path: ".";
    in-out property <string> status-text: "Ожидание анализа";
    in-out property <string> disk-text: "Данные о диске появятся после анализа";
    in-out property <string> files-text: "Файлы: —";
    in-out property <string> elapsed-text: "Время: —";
    in-out property <string> progress-text: "Ожидание";
    in-out property <int> progress-value: 0;
    in-out property <int> active-page: 0;
    in-out property <length> map-height: 270px;
    in-out property <float> map-height-control: 270;
    in-out property <[CategoryRow]> category-rows: [];
    in-out property <[TreeRow]> tree-rows: [];
    in-out property <[Tile]> tiles: [];
    in-out property <string> scanned-root: "";
    in-out property <[DiskRow]> disks: [];
    in-out property <[TrashRow]> trash-rows: [];
    in-out property <string> trash-status: "Мусор не просканирован";
    in-out property <string> trash-total-text: "0 байт";
    callback choose-folder();
    callback start-analysis();
    callback open-report();
    callback refresh-disks();
    callback toggle-tree-row(name: string);
    callback scan-trash();
    callback clean-trash(string);
    callback clean-selected-trash();
    callback clean-all-trash();
    callback toggle-trash-row(string);

    changed map-height-control => { root.map-height = root.map-height-control * 1px; }

    HorizontalLayout {
        padding: 7px;
        spacing: 9px;
        Rectangle {
            width: 204px;
            background: #1b1d20;
            border-radius: 16px;
            VerticalLayout {
                padding: 13px;
                spacing: 9px;
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Image { source: @image-url("icons/AccuSpace-icon.png"); width: 34px; height: 34px; image-fit: contain; }
                    VerticalLayout { spacing: 1px;
                        Text { text: "Accu Space"; color: #f0f1f2; font-size: 15px; font-weight: 700; }
                        Text { text: "KRM TECH SOFTWARE"; color: #979ba2; font-size: 8px; }
                    }
                }
                Rectangle { height: 1px; background: #303237; }
                Text { text: "РАБОЧЕЕ ПРОСТРАНСТВО"; color: #92969d; font-size: 9px; }
                NavItem { label: "Диски"; icon: @image-url("icons/disk.svg"); selected: root.active-page == 0; activate => { root.active-page = 0; } }
                NavItem { label: "Обзор"; icon: @image-url("icons/chart.svg"); selected: root.active-page == 1; activate => { root.active-page = 1; } }
                NavItem { label: "Карта и дерево"; icon: @image-url("icons/tree.svg"); selected: root.active-page == 2; activate => { root.active-page = 2; } }
                NavItem { label: "Очистка мусора"; icon: @image-url("icons/trash.svg"); selected: root.active-page == 3; activate => { root.active-page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle { height: 1px; background: #303237; }
                Text { text: "СОСТОЯНИЕ"; color: #92969d; font-size: 9px; }
                Text { text: root.status-text; color: #d6d8db; font-size: 11px; wrap: word-wrap; }
                Rectangle {
                    height: 6px; background: #34373c; border-radius: 3px; clip: true;
                    HorizontalLayout {
                        padding: 0px;
                        Rectangle { width: parent.width * root.progress-value / 100; height: parent.height; background: #8496a8; border-radius: 3px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
                Text { text: root.progress-text; color: #aeb2b8; font-size: 10px; wrap: word-wrap; }
                Rectangle { height: 1px; background: #303237; }
                Text { text: "ACCU SPACE  ·  KRM TECH SOFTWARE"; color: #858990; font-size: 9px; }
            }
        }

        if root.active-page == 0: VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                VerticalLayout { spacing: 3px;
                    Text { text: "Подключённые диски"; color: #eceef0; font-size: 26px; font-weight: 700; }
                    Text { text: "Выберите файловую систему для просмотра или анализа"; color: #a7abb1; font-size: 13px; }
                }
                ActionButton { label: "Обновить"; clicked => { root.refresh-disks(); } }
            }
            Rectangle {
                vertical-stretch: 1; background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 16px; spacing: 8px;
                    ScrollView {
                        VerticalLayout {
                            width: 100%; spacing: 10px; padding-right: 26px; padding-bottom: 6px;
                            if root.disks.length == 0: Text { text: "Поиск доступных дисков…"; color: #a7abb1; height: 80px; vertical-alignment: center; horizontal-alignment: center; }
                            GridLayout {
                                width: 100%; spacing: 10px;
                                for disk[index] in root.disks: Rectangle {
                                row: index / 2; col: Math.mod(index, 2); width: (parent.width - 10px) / 2;
                                height: 136px; background: #292c30; border-radius: 11px; border-width: 1px; border-color: #393d42;
                                Image { source: @image-url("icons/disk.svg"); x: 14px; y: 13px; width: 30px; height: 30px; image-fit: contain; }
                                Text { text: disk.name; x: 54px; y: 12px; width: parent.width - 120px; color: #eceef0; font-size: 15px; font-weight: 650; }
                                Text { text: disk.path; x: 54px; y: 34px; width: parent.width - 120px; color: #a7abb1; font-size: 11px; }
                                Text { text: disk.kind; x: parent.width - 76px; y: 14px; width: 62px; color: #b2b6bc; font-size: 11px; horizontal-alignment: right; }
                                Rectangle {
                                    x: 14px; y: 55px; width: parent.width - 28px; height: 7px;
                                    background: #41454a; border-radius: 4px; clip: true;
                                    Rectangle { x: 0px; width: disk.used-ratio * parent.width; height: parent.height; background: #91a0ae; border-radius: 4px; }
                                }
                                Text { text: disk.total; x: 14px; y: 68px; width: (parent.width - 28px) / 3; color: #e1e3e6; font-size: 10px; }
                                Text { text: disk.used; x: 14px + (parent.width - 28px) / 3; y: 68px; width: (parent.width - 28px) / 3; color: #a7abb1; font-size: 10px; horizontal-alignment: center; }
                                Text { text: disk.free; x: 14px + 2 * (parent.width - 28px) / 3; y: 68px; width: (parent.width - 28px) / 3; color: #a7abb1; font-size: 10px; horizontal-alignment: right; }
                                SmallButton { x: parent.width - 126px; y: 91px; label: "Анализировать"; clicked => { root.root-path = disk.path; root.active-page = 1; root.start-analysis(); } }
                            }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 1: VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                VerticalLayout { spacing: 3px;
                    Text { text: "Обзор хранилища"; color: #eceef0; font-size: 26px; font-weight: 700; }
                    Text { text: "Сводка занятого пространства и типов файлов"; color: #a7abb1; font-size: 13px; }
                }
                ActionButton { label: "Открыть отчёт"; clicked => { root.open-report(); } }
            }
            Rectangle {
                background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 14px; spacing: 9px;
                    Text { text: "ПАПКА АНАЛИЗА"; color: #aeb2b8; font-size: 10px; font-weight: 700; }
                    HorizontalLayout { spacing: 8px;
                        LineEdit { text <=> root.root-path; placeholder-text: "Путь к папке"; horizontal-stretch: 1; }
                        ActionButton { label: "Обзор…"; clicked => { root.choose-folder(); } }
                        ActionButton { label: "Анализировать"; primary: true; clicked => { root.start-analysis(); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle { background: #202225; border-radius: 12px; border-width: 1px; border-color: #34373c;
                    VerticalLayout { padding: 13px; spacing: 7px;
                        Text { text: "ДИСК"; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: root.disk-text; color: #e5e7e9; font-size: 14px; wrap: word-wrap; }
                    }
                }
                Rectangle { background: #202225; border-radius: 12px; border-width: 1px; border-color: #34373c;
                    VerticalLayout { padding: 13px; spacing: 7px;
                        Text { text: "ФАЙЛЫ"; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: root.files-text; color: #e5e7e9; font-size: 14px; wrap: word-wrap; }
                    }
                }
                Rectangle { background: #202225; border-radius: 12px; border-width: 1px; border-color: #34373c;
                    VerticalLayout { padding: 13px; spacing: 7px;
                        Text { text: "ВРЕМЯ АНАЛИЗА"; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: root.elapsed-text; color: #e5e7e9; font-size: 14px; }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 16px; spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Категории файлов"; color: #eceef0; font-size: 17px; font-weight: 700; }
                        Text { text: "Размер распределён по типам"; color: #a7abb1; horizontal-alignment: right; }
                    }
                    HorizontalLayout {
                        Text { text: "КАТЕГОРИЯ"; width: 34%; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: "РАЗМЕР"; width: 23%; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: "ФАЙЛОВ"; width: 18%; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: "ДОЛЯ"; horizontal-alignment: right; color: #a7abb1; font-size: 10px; font-weight: 700; }
                    }
                    Rectangle { height: 1px; background: #36393e; }
                    ScrollView {
                        VerticalLayout {
                            width: 100%; padding-right: 30px; padding-bottom: 6px;
                            if root.category-rows.length == 0: Text {
                                text: "Выберите папку и запустите анализ, чтобы увидеть разбивку.";
                                color: #a7abb1; height: 100px; vertical-alignment: center; horizontal-alignment: center;
                            }
                            for row in root.category-rows: HorizontalLayout {
                                height: 34px;
                                Text { text: row.name; width: 34%; color: #e1e3e6; }
                                Text { text: row.size; width: 23%; color: #e1e3e6; }
                                Text { text: row.files; width: 18%; color: #b2b6bc; }
                                Text { text: row.percent; horizontal-alignment: right; color: #b8c5d0; font-weight: 600; }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 2: VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                VerticalLayout { spacing: 3px;
                    Text { text: "Карта и дерево"; color: #eceef0; font-size: 26px; font-weight: 700; }
                    Text { text: root.scanned-root == "" ? "Выполните анализ, чтобы построить карту файлов" : root.scanned-root; color: #a7abb1; font-size: 12px; }
                }
                ActionButton { label: "Открыть отчёт"; clicked => { root.open-report(); } }
            }
            Rectangle {
                height: root.map-height; vertical-stretch: 0; background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 14px; spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Карта размеров"; color: #eceef0; font-size: 16px; font-weight: 700; }
                        Text { text: "Площадь плитки соответствует размеру файла · цвет по типу"; color: #a7abb1; horizontal-alignment: right; font-size: 11px; }
                        Slider { minimum: 180; maximum: 520; value <=> root.map-height-control; width: 120px; }
                    }
                    Rectangle {
                        background: #17191b; border-radius: 9px; clip: true;
                        if root.tiles.length == 0: Text { text: "Карта появится после анализа"; color: #a7abb1; horizontal-alignment: center; vertical-alignment: center; }
                        for tile in root.tiles: Rectangle {
                            x: tile.x * parent.width; y: tile.y * parent.height; width: tile.width * parent.width; height: tile.height * parent.height;
                            background: tile.color; border-radius: 2px; border-width: 1px; border-color: #202225;
                            if tile.width * parent.width > 72px && tile.height * parent.height > 38px: VerticalLayout {
                                padding: 6px; spacing: 2px;
                                Text { text: tile.label; color: #f1f2f3; font-size: 11px; font-weight: 600; overflow: elide; }
                                Text { text: tile.size; color: #e0e2e5; font-size: 10px; }
                            }
                        }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1; background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 14px; spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Дерево файлов"; color: #eceef0; font-size: 16px; font-weight: 700; }
                        Text { text: "Папки и файлы по размеру"; color: #a7abb1; horizontal-alignment: right; font-size: 11px; }
                    }
                    Rectangle {
                        height: 28px; background: #292c30; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { text: "ИМЯ"; horizontal-stretch: 1; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "ТИП"; width: 90px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "РАЗМЕР"; width: 110px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "ФАЙЛОВ"; width: 80px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            width: 100%; padding-right: 30px; padding-bottom: 6px;
                            if root.tree-rows.length == 0: Text { text: "Дерево появится после завершения анализа."; color: #a7abb1; height: 70px; vertical-alignment: center; horizontal-alignment: center; }
                            for row in root.tree-rows: Rectangle {
                                height: 32px;
                                background: row.is-file ? #26292c : #2c3034;
                                border-radius: 5px;
                                Text { text: row.expandable ? (row.expanded ? "⌄" : "›") : ""; x: row.indent; width: 12px; color: #aeb7c0; vertical-alignment: center; horizontal-alignment: center; }
                                Rectangle { x: row.indent + 13px; y: 7px; width: 3px; height: 18px; background: row.color; border-radius: 2px; }
                                Image { source: row.is-file ? @image-url("icons/file.svg") : @image-url("icons/folder.svg"); x: row.indent + 19px; y: 7px; width: 18px; height: 18px; image-fit: contain; }
                                Text { text: row.name; x: row.indent + 40px; width: parent.width - row.indent - 330px; color: #e1e3e6; vertical-alignment: center; overflow: elide; }
                                Text { text: row.kind; x: parent.width - 290px; width: 90px; color: #a7abb1; vertical-alignment: center; }
                                Text { text: row.size; x: parent.width - 200px; width: 110px; color: #e1e3e6; vertical-alignment: center; }
                                Text { text: row.files; x: parent.width - 90px; width: 80px; color: #b2b6bc; vertical-alignment: center; }
                                TouchArea { clicked => { if row.expandable { root.toggle-tree-row(row.key); } } }
                            }
                        }
                    }
                }
            }
        }

        if root.active-page == 3: VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                VerticalLayout { spacing: 3px;
                    Text { text: "Очистка мусора и кэша"; color: #eceef0; font-size: 26px; font-weight: 700; }
                    Text { text: "Поиск и удаление временных файлов, кэша и артефактов разработки"; color: #a7abb1; font-size: 13px; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { label: "Сканировать"; clicked => { root.scan-trash(); } }
                    ActionButton { label: "Очистить выбранное"; clicked => { root.clean-selected-trash(); } }
                    ActionButton { label: "Очистить всё"; primary: true; clicked => { root.clean-all-trash(); } }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle { background: #202225; border-radius: 12px; border-width: 1px; border-color: #34373c;
                    VerticalLayout { padding: 13px; spacing: 7px;
                        Text { text: "ОБНАРУЖЕНО МУСОРА"; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: root.trash-total-text; color: #e5e7e9; font-size: 14px; font-weight: 600; }
                    }
                }
                Rectangle { background: #202225; border-radius: 12px; border-width: 1px; border-color: #34373c;
                    VerticalLayout { padding: 13px; spacing: 7px;
                        Text { text: "СТАТУС"; color: #a7abb1; font-size: 10px; font-weight: 700; }
                        Text { text: root.trash-status; color: #e5e7e9; font-size: 14px; wrap: word-wrap; }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1; background: #202225; border-radius: 14px; border-width: 1px; border-color: #34373c;
                VerticalLayout { padding: 16px; spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Элементы мусора и кэша"; color: #eceef0; font-size: 17px; font-weight: 700; }
                        Text { text: "Выберите элементы для очистки"; color: #a7abb1; horizontal-alignment: right; }
                    }
                    Rectangle {
                        height: 28px; background: #292c30; border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { text: "ВЫБОР"; width: 60px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "КАТЕГОРИЯ И НАЗВАНИЕ"; horizontal-stretch: 1; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "РАЗМЕР"; width: 110px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            Text { text: "ДЕЙСТВИЕ"; width: 100px; color: #b1b5bb; font-size: 10px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                    ScrollView {
                        VerticalLayout {
                            width: 100%; padding-right: 30px; padding-bottom: 6px; spacing: 6px;
                            if root.trash-rows.length == 0: Text {
                                text: "Нажмите «Сканировать», чтобы найти мусор и временные файлы.";
                                color: #a7abb1; height: 100px; vertical-alignment: center; horizontal-alignment: center;
                            }
                            for row in root.trash-rows: Rectangle {
                                height: 48px; background: #26292c; border-radius: 7px;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: center;
                                    Rectangle {
                                        width: 40px; height: 48px;
                                        TouchArea {
                                            clicked => { root.toggle-trash-row(row.key); }
                                        }
                                        Rectangle {
                                            x: 10px; y: 16px; width: 16px; height: 16px; border-radius: 4px;
                                            border-width: 2px; border-color: row.selected ? #526579 : #52575f;
                                            background: row.selected ? #526579 : transparent;
                                            Text { text: row.selected ? "✓" : ""; color: #fff; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    VerticalLayout {
                                        vertical-stretch: 1; alignment: center; spacing: 2px; width: parent.width - 290px;
                                        Text { text: row.name; color: #e1e3e6; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: row.path; color: #979ba2; font-size: 10px; overflow: elide; }
                                    }
                                    VerticalLayout {
                                        width: 110px; vertical-stretch: 1; alignment: center; spacing: 2px;
                                        Text { text: row.size; color: #e1e3e6; font-size: 12px; font-weight: 600; }
                                        Text { text: row.count + " файлов"; color: #979ba2; font-size: 10px; }
                                    }
                                    Rectangle {
                                        width: 100px; height: 32px; y: 8px;
                                        SmallButton {
                                            label: "Очистить";
                                            clicked => { root.clean-trash(row.key); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
